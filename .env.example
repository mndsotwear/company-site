# این فایل را کپی کنید و نامش را .env بگذارید، سپس مقادیر را عوض کنید

# آدرس دیتابیس PostgreSQL
# روی کامپیوتر: سرویس shahin-marine در DBngin (کاربر postgres بدون رمز، پورت 5433)
DATABASE_URI=postgres://postgres@localhost:5433/shahin_marine

# یک متن تصادفی و طولانی (حداقل ۳۲ کاراکتر) برای امنیت پنل
PAYLOAD_SECRET=change-me-to-a-long-random-string-1234567890

# آدرس سایت (روی سرور اصلی: https://shahinmarine.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- پیامک (کاوه‌نگار) ----
# اگر خالی باشد، پیامک ارسال نمی‌شود و فقط در ترمینال نوشته می‌شود
KAVENEGAR_API_KEY=
# شماره‌ی فرستنده (خط اختصاصی) از پنل کاوه‌نگار
KAVENEGAR_SENDER=
